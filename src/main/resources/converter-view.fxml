<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="14" prefWidth="480" prefHeight="520"
  style="-fx-background-color: #f4f6f8;"
  xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <padding>
    <Insets top="25" right="35" bottom="25" left="35"/>
  </padding>

  <HBox alignment="CENTER_LEFT">
    <Button text="← Назад" onAction="#onBackClick"
      style="-fx-background-color: transparent; -fx-text-fill: #2e6cbf;"/>
  </HBox>

  <Label text="💱 Конвертер аудіо" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
  <Label text="Платна послуга: конвертація в MP3, WAV або MP4" style="-fx-text-fill: gray; -fx-font-size: 12px;"/>

  <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
    <Label text="Трек:" style="-fx-font-weight: bold;"/>
    <ChoiceBox fx:id="trackChoiceBox" maxWidth="Infinity"/>

    <Label text="Цільовий формат:" style="-fx-font-weight: bold;"/>
    <ChoiceBox fx:id="formatChoiceBox" maxWidth="Infinity"/>

    <Label fx:id="priceLabel" style="-fx-font-size: 14px; -fx-text-fill: #3f7cd6; -fx-font-weight: bold;"/>
  </VBox>

  <Separator/>

  <VBox spacing="8">
    <Label text="Дані картки" style="-fx-font-weight: bold;"/>
    <TextField fx:id="cardNumberField" promptText="Номер картки (16 цифр)"
      style="-fx-background-radius: 6; -fx-padding: 8;"/>
    <HBox spacing="8">
      <TextField fx:id="expiryField" promptText="MM/YY" HBox.hgrow="ALWAYS"
        style="-fx-background-radius: 6; -fx-padding: 8;"/>
      <PasswordField fx:id="cvvField" promptText="CVV" HBox.hgrow="ALWAYS"
        style="-fx-background-radius: 6; -fx-padding: 8;"/>
    </HBox>
  </VBox>

  <Button fx:id="payButton" text="Оплатити і конвертувати" onAction="#onPayAndConvertClick"
    maxWidth="Infinity"
    style="-fx-background-color: #3f7cd6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10;"/>

  <ProgressIndicator fx:id="progressIndicator" maxWidth="40" maxHeight="40"/>
  <Label fx:id="statusLabel" wrapText="true"/>
</VBox>