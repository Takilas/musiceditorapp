<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" prefWidth="400" prefHeight="460"
  xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <padding>
    <Insets top="30" right="35" bottom="30" left="35"/>
  </padding>

  <Label text="🎵" style="-fx-font-size: 32px;"/>
  <Label text="Реєстрація" styleClass="page-title"/>

  <VBox fx:id="registrationPane" spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
    <TextField fx:id="usernameField" promptText="Ім'я користувача"
      style="-fx-background-radius: 6; -fx-padding: 8;"/>
    <TextField fx:id="emailField" promptText="Email"
      style="-fx-background-radius: 6; -fx-padding: 8;"/>
    <PasswordField fx:id="passwordField" promptText="Пароль"
      style="-fx-background-radius: 6; -fx-padding: 8;"/>
    <Button text="Зареєструватися" defaultButton="true" onAction="#onRegisterClick" maxWidth="Infinity"
      style="-fx-background-color: #3f7cd6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8;"/>
    <Label fx:id="registerErrorLabel" wrapText="true"/>
  </VBox>

  <VBox fx:id="verificationPane" spacing="10" alignment="CENTER" visible="false" managed="false"
    style="-fx-padding: 10 0 0 0;">
    <Label fx:id="verificationInfoLabel" wrapText="true" styleClass="subtitle"/>
    <TextField fx:id="codeField" promptText="Код з листа (6 цифр)"
      style="-fx-background-radius: 6; -fx-padding: 8;"/>
    <Button text="Підтвердити" defaultButton="true" onAction="#onVerifyClick" maxWidth="Infinity"
      style="-fx-background-color: #3f7cd6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8;"/>
    <Label fx:id="verifyErrorLabel" wrapText="true"/>
  </VBox>

  <Button text="Назад до входу" onAction="#onBackToLoginClick"
    maxWidth="Infinity" styleClass="link-button"/>
</VBox>